# Shared / public environment variables
# Copy to .env.local and fill in real values.
NEXT_PUBLIC_SITE_URL=https://nothing.digital
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase-anon-key>

# Umami (optional — omit until PikaPods pod is live; falls back to Vercel Analytics)
NEXT_PUBLIC_UMAMI_WEBSITE_ID=<umami-website-uuid>
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://analytics.nothing.digital/script.js

# Sentry (optional for local development; omit to disable error reporting)
SENTRY_DSN=https://<key>@sentry.io/<project>
