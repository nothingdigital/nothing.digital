# Shared / public environment variables
# Copy to .env.local and fill in real values.
NEXT_PUBLIC_SITE_URL=https://nothing.digital
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase-anon-key>

# Umami (optional — omit until PikaPods pod is live; falls back to Vercel Analytics)
NEXT_PUBLIC_UMAMI_WEBSITE_ID=<umami-website-uuid>
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://analytics.nothing.digital/script.js

# Admin (comma-separated allowlist for magic-link owners)
ADMIN_EMAILS=you@nothing.digital

# Admin tool links (server-only — rendered in /admin pages)
CALENDLY_URL=https://calendly.com/your-link
UMAMI_DASHBOARD_URL=https://analytics.nothing.digital
LISTMONK_DASHBOARD_URL=https://newsletter.nothing.digital
N8N_DASHBOARD_URL=https://automation.nothing.digital
KUMA_DASHBOARD_URL=https://status.nothing.digital

# Listmonk (optional — omit until pod live; newsletter stays on Supabase)
LISTMONK_URL=https://newsletter.nothing.digital
LISTMONK_LIST_UUID=<public-list-uuid>

# n8n (optional — omit until pod live; contact/newsletter still succeed without it)
N8N_WEBHOOK_URL=https://automation.nothing.digital/webhook/<id>
N8N_WEBHOOK_SECRET=<shared-secret>

# Sentry (optional for local development; omit to disable error reporting)
SENTRY_DSN=https://<key>@sentry.io/<project>
