# Local-only secrets
# Never commit this file. Copy to .env.local and fill in real values.
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>
RESEND_API_KEY=<resend-api-key>
# Where contact form notifications are sent
CONTACT_NOTIFY_EMAIL=<alexander@nothing.digital>
# Comma-separated owner emails for /admin magic link
ADMIN_EMAILS=<alexander@nothing.digital>
UPSTASH_REDIS_REST_URL=https://<project>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<upstash-token>
SENTRY_AUTH_TOKEN=<sentry-auth-token>

# Optional PikaPods sidecars (omit until pods live — see .env.example)
# LISTMONK_URL=https://newsletter.nothing.digital
# LISTMONK_LIST_UUID=<uuid>
# N8N_WEBHOOK_URL=https://automation.nothing.digital/webhook/<id>
# N8N_WEBHOOK_SECRET=<secret>

# AI (optional — Vercel AI Gateway)
# AI_GATEWAY_API_KEY=
# AI_MODEL=mistral/mistral-small
# AI_INBOX_DRAFTS_ENABLED=true
# AI_OPS_BRIEF_ENABLED=true
# AI_INVOICE_COVER_ENABLED=true
# AI_OUTBOUND_PERSONALIZATION_ENABLED=true

# CI/CD secrets (not used locally; stored in GitHub Secrets)
# VERCEL_TOKEN=<vercel-token>
# VERCEL_ORG_ID=<vercel-org-id>
# VERCEL_PROJECT_ID=<vercel-project-id>
