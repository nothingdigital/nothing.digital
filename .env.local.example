# Local-only secrets
# Never commit this file. Copy to .env.local and fill in real values.
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>
RESEND_API_KEY=<resend-api-key>
# Where contact form notifications are sent
CONTACT_NOTIFY_EMAIL=<you@example.com>
UPSTASH_REDIS_REST_URL=https://<project>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<upstash-token>
SENTRY_AUTH_TOKEN=<sentry-auth-token>

# CI/CD secrets (not used locally; stored in GitHub Secrets)
# VERCEL_TOKEN=<vercel-token>
# VERCEL_ORG_ID=<vercel-org-id>
# VERCEL_PROJECT_ID=<vercel-project-id>
